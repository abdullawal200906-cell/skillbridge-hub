# Copy to .env for local use. On Render/Railway, add these in the dashboard instead.
PORT=3000

# JSearch on RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JOB_API_KEY=            # JSearch (RapidAPI) key
JOB_COUNTRY=ng
JOB_API_KEY_2=          # Jooble key (covers Nigeria), optional
JOB_API_KEY_3=          # spare JSearch key from a second RapidAPI account, optional

# Optional: email contact messages with Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Job & Skills Hub <onboarding@resend.dev>"
EMAIL_TO=lawalolorunifemi@gmail.com

# Optional: real AI chat for "Sage" (Anthropic API, https://console.anthropic.com)
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-haiku-4-5-20251001

# Exams and certificates
CERT_SECRET=            # long random text; signs pass tokens. Required in production
EXAM_MODEL=claude-sonnet-5-5
EXAM_SIZE=50            # questions per topic test (10 to 80)
PASS_MARK=70
PUBLIC_URL=             # your site address, e.g. https://skillbridge.onrender.com (used in certificate verify links)
