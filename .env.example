# Copy to .env for local use. On Render, add these in the Environment page instead.
PORT=3000

# Job search
JOB_API_KEY=
JOB_API_KEY_3=
JOOBLE_API_KEY=
OPENWEBNINJA_API_KEY=
JOB_COUNTRY=ng

# Database: Upstash Redis (use the read/write token, not the read-only one)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI coach and exam questions (use Groq, or Gemini as an alternative)
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=

# Contact form email: Resend
RESEND_API_KEY=
EMAIL_FROM="SkillBridge Hub <onboarding@resend.dev>"
EMAIL_TO=your-email@example.com

# Exams and certificates
CERT_SECRET=
EXAM_SIZE=50
PASS_MARK=70
PUBLIC_URL=https://your-site.onrender.com